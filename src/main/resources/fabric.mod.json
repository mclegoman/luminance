{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${version}",
  "name": "${modName}",
  "description": "${modDescription}",
  "authors": [
    {
      "name": "dannytaylor",
      "contact": {
        "homepage": "https://modrinth.com/user/dannytaylor"
      }
    },
    {
      "name": "Nettakrim",
      "contact": {
        "homepage": "https://modrinth.com/user/Nettakrim"
      }
    }
  ],
  "contributors": [
  ],
  "contact": {
    "homepage": "${homepage}",
    "issues": "${issues}",
    "sources": "${sources}"
  },
  "license": "${license}",
  "icon": "assets/${modId}/textures/icons/icon.png",
  "depends": {
    "fabric-api": ">=${fapi}",
    "fabricloader": "*",
    "minecraft": ">=${mc}"
  },
  "entrypoints": {
    "client": [
      "com.mclegoman.luminance.client.LuminanceClient"
    ],
    "modmenu": [
      "com.mclegoman.luminance.compat.ModMenuCompat"
    ],
    "sodium:config_api_user": [
      "com.mclegoman.luminance.compat.SodiumConfigCompat"
    ]
  },
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ]
    }
  },
  "mixins": [
    "dt-luminance.mixins.json"
  ]
}